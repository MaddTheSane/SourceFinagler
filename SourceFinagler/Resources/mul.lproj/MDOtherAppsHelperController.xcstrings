    "1350.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"When attempting to target a specific application, the USB Overdrive preference pane for System Preferences has a bug that won’t allow you to choose the plain “hl2_osx” file (after the attempt, System Preferences is unresponsive). Instead, you should choose the special “hl2_osx (for USB Overdrive).app” application bundle, as shown in the image below:\"; ObjectID = \"1350\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When attempting to target a specific application, the USB Overdrive preference pane for System Preferences has a bug that won’t allow you to choose the plain “hl2_osx” file (after the attempt, System Preferences is unresponsive). Instead, you should choose the special “hl2_osx (for USB Overdrive).app” application bundle, as shown in the image below:"
          }
        }
      }
    },
    "1410.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"OK\"; ObjectID = \"1410\";",
      "extractionState" : "extracted_with_value",

          }
        }
      }
    },
    "1459.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Use this feature to help allow other Mac OS X applications to better recognize Source games as applications. For example, if you use third-party mouse software such as SteerMouse or USBOverdrive, “helping” Valve’s games will allow you to add a custom profile for each game. It may also help if you are using the Simple Finder and/or Parental controls.\\n\\nNote: You can also double-click on a game in the list to launch it (it will be helped automatically if necessary).\"; ObjectID = \"1459\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use this feature to help allow other Mac OS X applications to better recognize Source games as applications. For example, if you use third-party mouse software such as SteerMouse or USBOverdrive, “helping” Valve’s games will allow you to add a custom profile for each game. It may also help if you are using the Simple Finder and/or Parental controls.\n\nNote: You can also double-click on a game in the list to launch it (it will be helped automatically if necessary)."
          }
        }
      }
    },
